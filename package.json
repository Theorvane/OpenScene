{
  "name": "video-window-recorder",
  "productName": "OpenScene",
  "version": "0.10.0",
  "description": "OpenScene local video editor with timeline, connected canvas and multimodal editing assistant.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "verify:media-analysis": "powershell -NoProfile -File scripts/verify-media-analysis.ps1",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --publish never",
    "setup:transcription": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-transcription-runtime.ps1"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.3",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@theorvane/type-mcp": "0.3.1",
    "@vitejs/plugin-react": "5.1.4",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  },
  "author": {
    "name": "Theorvane",
    "email": "sjungwon03@gmail.com"
  }
}
