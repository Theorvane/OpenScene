# Optional: override where app-generated WebM recordings are stored.
# If omitted, recordings are saved under Electron's userData directory.
# VIDEO_TOOL_RECORDINGS_DIR=/absolute/path/to/recordings

# Optional: explicit whisper.cpp overrides. Without them OpenScene discovers
# the verified runtime installed by `npm run setup:transcription` under
# .local-runtimes/. Both override paths must be absolute. The checksum is
# optional for development and recommended for every custom runtime.
# OPENSCENE_WHISPER_CPP_PATH=D:\whisper.cpp\build\bin\Release\whisper-cli.exe
# OPENSCENE_WHISPER_MODEL_PATH=D:\whisper.cpp\models\ggml-small.bin
# OPENSCENE_WHISPER_MODEL_SHA256=
# Optional CUDA package. Leave off on GTX 1650: the official generic CUDA build
# benchmarks slower than its CPU build on this GPU because it lacks Tensor Cores.
# OPENSCENE_WHISPER_CUDA=false

# Windows: when native FFprobe cannot start, use the prepared local Linux image.
# Requires Docker Desktop's Linux engine and scripts/verify-media-analysis.ps1.
# No engine start, image download or build is performed by the app.
# VIDEO_TOOL_FFPROBE_LINUX_FALLBACK=false
# Select the prepared Linux runtime directly on Windows (default prefers native).
# VIDEO_TOOL_FFPROBE_RUNTIME=linux-container
# VIDEO_TOOL_FFPROBE_LINUX_IMAGE=openscene-media-analysis:local
# Optional absolute path when Docker is not on the app's PATH:
# VIDEO_TOOL_FFPROBE_DOCKER_PATH=C:\Program Files\Docker\Docker\resources\bin\docker.exe
